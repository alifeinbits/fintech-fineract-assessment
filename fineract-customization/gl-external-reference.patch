+import org.junit.jupiter.api.Test;
+
+class GLAccountExternalReferenceSyncTest {
+
+    @Test
+    void matchesIdenticalPayloadAndCurrencyCase() {
+        GLAccount account = new GLAccount().setGlCode("1200").setName("Loan Receivable").setType(1).setCurrencyCode("rwf");
+        assertTrue(GLAccountExternalReferenceSync.matches(account, "1200", "Loan Receivable", 1, "RWF"));
+    }
+
+    @Test
+    void rejectsDifferentNameOrCodeOrType() {
+        GLAccount account = new GLAccount().setGlCode("1200").setName("Loan Receivable").setType(1).setCurrencyCode("RWF");
+        assertFalse(GLAccountExternalReferenceSync.matches(account, "1200", "Other", 1, "RWF"));
+        assertFalse(GLAccountExternalReferenceSync.matches(account, "1100", "Loan Receivable", 1, "RWF"));
+        assertFalse(GLAccountExternalReferenceSync.matches(account, "1200", "Loan Receivable", 4, "RWF"));
+        assertFalse(GLAccountExternalReferenceSync.matches(account, "1200", "Loan Receivable", 1, "USD"));
+    }
+}
