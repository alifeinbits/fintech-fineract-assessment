+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.apache.fineract.infrastructure.core.exception.AbstractPlatformDomainRuleException;
+
+/**
+ * Same external id, different GL payload. Fineract maps domain-rule exceptions to HTTP 403, which is its equivalent of
+ * 409 Conflict.
+ */
+public class GLAccountExternalReferenceConflictException extends AbstractPlatformDomainRuleException {
+
+    public GLAccountExternalReferenceConflictException(final String externalId) {
+        super("error.msg.glaccount.externalid.conflict",
+                "General Ledger Account external id " + externalId + " already exists with a different payload", externalId);
+    }
+}
