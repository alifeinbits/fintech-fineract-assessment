+package org.apache.fineract.integrationtests.accounting;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+
+import io.restassured.builder.ResponseSpecBuilder;
+import io.restassured.response.Response;
+import io.restassured.specification.RequestSpecification;
+import io.restassured.specification.ResponseSpecification;
+import org.apache.fineract.integrationtests.client.IntegrationTest;
+import org.apache.fineract.integrationtests.common.Utils;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+public class GLAccountExternalReferenceIntegrationTest extends IntegrationTest {
+
+    private static final String URL = "/fineract-provider/api/v1/glaccounts?" + Utils.TENANT_IDENTIFIER;
+
+    @BeforeEach
+    void setUp() {
+        Utils.initializeRESTAssured();
+    }
+
+    @Test
+    void identicalExternalReferenceReturnsTheSameAccountAndADifferentPayloadConflicts() {
+        RequestSpecification requestSpec = Utils.initializeDefaultRequestSpecification();
+        ResponseSpecification ok = new ResponseSpecBuilder().expectStatusCode(200).build();
+        String externalId = "GL-IT-" + System.currentTimeMillis();
+        String body = accountJson(externalId, "Loan Receivable", "1200" + externalId.substring(externalId.length() - 4));
+        Integer firstId = Utils.performServerPost(requestSpec, ok, URL, body, "resourceId");
+        Integer secondId = Utils.performServerPost(requestSpec, ok, URL, body, "resourceId");
+        assertEquals(firstId, secondId);
+
+        String changed = accountJson(externalId, "Other name", "1200" + externalId.substring(externalId.length() - 4));
+        Response conflict = io.restassured.RestAssured.given().spec(requestSpec).body(changed).when().post(URL).andReturn();
+        assertEquals(403, conflict.statusCode());
+        assertNotEquals(firstId, null);
+    }
+
+    @Test
+    void createWithoutAuthenticationIsRejected() {
+        Response response = io.restassured.RestAssured.given().contentType("application/json")
+                .body(accountJson("GL-NOAUTH", "Bank", "1100-noauth")).when().post(URL).andReturn();
+        assertEquals(401, response.statusCode());
+    }
+
+    private static String accountJson(final String externalId, final String name, final String glCode) {
+        return "{\"name\":\"" + name + "\",\"glCode\":\"" + glCode + "\",\"type\":1,\"usage\":1,\"manualEntriesAllowed\":true,"
+                + "\"externalId\":\"" + externalId + "\",\"currencyCode\":\"RWF\"}";
+    }
+}
