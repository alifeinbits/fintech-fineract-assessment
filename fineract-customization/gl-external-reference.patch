+package org.apache.fineract.accounting.glaccount.service;
+
+import java.util.Objects;
+import org.apache.fineract.accounting.glaccount.domain.GLAccount;
+
+/**
+ * Compares the ERP identity of a GL account: code, name, type, and currency. Usage and description are Fineract-only.
+ */
+public final class GLAccountExternalReferenceSync {
+
+    private GLAccountExternalReferenceSync() {}
+
+    public static boolean matches(final GLAccount account, final String glCode, final String name, final Integer type,
+            final String currencyCode) {
+        return Objects.equals(account.getGlCode(), glCode) && Objects.equals(account.getName(), name)
+                && Objects.equals(account.getType(), type) && Objects.equals(normalize(account.getCurrencyCode()), normalize(currencyCode));
+    }
+
+    private static String normalize(final String value) {
+        return value == null ? "" : value.trim().toUpperCase();
+    }
+}
